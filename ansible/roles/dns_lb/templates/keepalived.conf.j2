# {{ ansible_managed }}
# /etc/keepalived/keepalived.conf ({{ 'primary' if inventory_hostname == dns_lb_keepalived_primary else 'backup' }})

global_defs {
    router_id HAPROXY_DNS_{{ groups['dns_lb'].index(inventory_hostname) + 1 }}
}

vrrp_script check_haproxy {
    script "/usr/bin/killall -0 haproxy dnsdist"
    interval 2
    weight 2
}

vrrp_instance VI_DNS {
    state {{ 'MASTER' if inventory_hostname == dns_lb_keepalived_primary else 'BACKUP' }}
    interface {{ dns_lb_keepalived_interface }}
    virtual_router_id {{ dns_lb_keepalived_router_id }}
    priority {{ 101 if inventory_hostname == dns_lb_keepalived_primary else 100 }}
    advert_int 1

    authentication {
        auth_type PASS
        auth_pass {{ dns_lb_keepalived_auth_pass }}
    }

    virtual_ipaddress {
{% for vip in dns_lb_vips %}
        {{ vip.address }}{{ (' dev ' ~ vip.interface) if vip.interface is defined else '' }}
{% endfor %}
    }

    track_script {
        check_haproxy
    }
}
