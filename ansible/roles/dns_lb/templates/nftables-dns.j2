table ip dns_udp {
    chain prerouting {
        type nat hook prerouting priority dstnat; policy accept;
        ip daddr {{ dns_lb_internal_vip }} udp dport 53 redirect to :{{ dns_lb_dnsdist_internal_port }}
        ip daddr {{ dns_lb_auth_vip }} udp dport 53 redirect to :{{ dns_lb_dnsdist_auth_port }}
    }
}
